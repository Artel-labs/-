APPLICATION_MAX_RETENTION_DAYS=365
ANALYTICS_RETENTION_DAYS=90
AXES_LOG_RETENTION_DAYS=90
LOG_RETENTION_DAYS=90
ANALYTICS_MAX_EVENTS=250000
