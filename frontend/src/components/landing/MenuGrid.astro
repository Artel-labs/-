---
import type { MenuSphere } from "../../lib/landing";

interface Props {
  spheres: MenuSphere[];
}

const { spheres } = Astro.props;
---

<div class="dpo-menu-grid">
  {
    spheres.map((sphere) => (
      <div class="dpo-menu-sphere">
        <a class="dpo-menu-sphere-head" href={sphere.href}>
          <span class="dpo-menu-sphere-title">{sphere.title}</span>
          <span class="dpo-menu-sphere-count">{sphere.count}</span>
        </a>
        <ul class="dpo-menu-programs">
          {sphere.programs.map((program) => (
            <li>
              <a class="dpo-menu-program" href={program.href}>
                {program.title}
              </a>
            </li>
          ))}
        </ul>
        {sphere.more && (
          <a class="dpo-menu-more" href={sphere.more.href}>
            {sphere.more.title}
          </a>
        )}
      </div>
    ))
  }
</div>
