---
import type { StartStrip } from "../../lib/landing";

interface Props {
  start: StartStrip;
  duplicate?: boolean;
}

const { start, duplicate = false } = Astro.props;
---

<a class="dpo-start" href={start.path} tabindex={duplicate ? "-1" : undefined} aria-label={start.label}>
  <span class="dpo-start-date" aria-hidden="true">
    <span class:list={["dpo-start-day", { "is-month": start.is_month }]}>{start.big}</span>
    <span class="dpo-start-mon">{start.small}</span>
  </span>
  <span class="dpo-start-title" aria-hidden="true">{start.title}</span>
</a>
