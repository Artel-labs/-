---
import type { SphereCard } from "../../lib/landing";
import SphereCards from "./SphereCards.astro";

interface Props {
  cards: SphereCard[];
  branches: string[];
}

const { cards, branches } = Astro.props;
---

<section data-screen-label="Programs by sphere" id="spheres" class="spheres-section">
  <div class="dpo-container">
    <div class="spheres-head">
      <div class="dpo-section-head spheres-intro">
<span class="dpo-eyebrow">Сферы права</span>
<h2 class="dpo-h2">Направления обучения: курсы для юристов по&nbsp;шести сферам права</h2>
<p class="dpo-lead">Обучение у&nbsp;лучших&nbsp;— это выбор тех, кто готов инвестировать в&nbsp;свой профессиональный уровень. Право&nbsp;— это сложная система специализированных областей. Мы&nbsp;собрали программы по&nbsp;ключевым направлениям, чтобы вы&nbsp;могли выбрать свою траекторию и&nbsp;получить доступ к&nbsp;знаниям, которые открывают новые карьерные возможности.</p>
</div>
      <aside class="quiz-card">
<h3 class="quiz-card-title">Не&nbsp;можете определиться?</h3>
<p class="quiz-card-text">Ответьте на&nbsp;несколько вопросов&nbsp;— и&nbsp;посмотрите программы по&nbsp;интересующей области права, документу и&nbsp;формату обучения.</p>
<a class="dpo-quiz-open quiz-card-button" data-quiz="" data-quiz-branches={JSON.stringify(branches)} href="/catalog">Пройти опрос</a>
</aside>
    </div>
    <SphereCards cards={cards} />
  </div>
</section>
