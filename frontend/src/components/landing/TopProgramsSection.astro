---
import type { TopProgram } from "../../lib/landing";
import TopProgramTile from "./TopProgramTile.astro";

interface Props {
  programs: TopProgram[];
}

const { programs } = Astro.props;
---

<section data-screen-label="Top 5 programs" id="top5" class="section-pad">
  <div class="dpo-container">
    <div class="dpo-carousel-head">
      <div class="dpo-section-head top5-intro">
<h2 class="dpo-h2">Выбор слушателей</h2>
</div>
      <div class="dpo-top5-aside">
        <div class="crow-walk-row">
          <div class="crow-walk-slot" data-crow-walk=""></div>
        </div>
        <div class="dpo-carousel-nav dpo-top5-nav top5-nav">
<a class="dpo-starts-all top5-all" href="/catalog">Все программы с&nbsp;фильтрами</a>
</div>
      </div>
    </div>
    <div class="dpo-top5-grid" role="list" aria-label="Программы Центра ДПО факультета права">
      {programs.map((program) => <TopProgramTile program={program} />)}
    </div>
  </div>
</section>
