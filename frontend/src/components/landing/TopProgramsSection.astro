---
import type { TopProgram } from "../../lib/landing";
import TopProgramTile from "./TopProgramTile.astro";

interface Props {
  programs: TopProgram[];
}

const { programs } = Astro.props;
---

{
  programs.length > 0 && (
<section data-screen-label="High rating programs" id="top5" class="section-pad">
  <div class="dpo-container">
    <div class="dpo-carousel-head">
      <div class="dpo-section-head top5-intro">
<h2 class="dpo-h2">Программы с&nbsp;высоким рейтингом</h2>
</div>
      <div class="dpo-top5-aside">
        <div class="crow-walk-row">
          <div class="crow-walk-slot" data-crow-walk="" />
        </div>
        <div class="dpo-carousel-nav dpo-top5-nav top5-nav">
<a class="dpo-starts-all top5-all" href="/catalog">Все программы с&nbsp;фильтрами</a>
<button aria-controls="topTrack" aria-label="Предыдущие программы" class="dpo-carousel-btn" data-dpo-scroll="prev" type="button">
<svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 16 16"><path d="M10 3 5 8l5 5" /></svg>
</button>
<button aria-controls="topTrack" aria-label="Следующие программы" class="dpo-carousel-btn" data-dpo-scroll="next" type="button">
<svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 16 16"><path d="M6 3l5 5-5 5" /></svg>
</button>
</div>
      </div>
    </div>
    <div id="topTrack" class="dpo-track dpo-top-track" tabindex="0" role="list" aria-label="Программы с высоким рейтингом">
      {programs.map((program) => <TopProgramTile program={program} />)}
    </div>
  </div>
</section>
  )
}
