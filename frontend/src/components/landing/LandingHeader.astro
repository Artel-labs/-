---
import { CATALOG_LINK_LABEL } from "../../lib/nav";
import HseLockup from "../HseLockup.astro";
import ViModeButton from "./ViModeButton.astro";
---

<header data-screen-label="Header" class="dpo-header">
  <div class="dpo-header-bar">
<span class="dpo-brand">
<HseLockup home="#top" />
</span>
<nav aria-label="Основная навигация" class="dpo-capsule">
<a href="/catalog">{CATALOG_LINK_LABEL}</a>
<a href="#formats">Форматы</a>
<a href="#teachers">Преподаватели</a>
<a href="/ratings">Рейтинги</a>
<a href="#contacts">Контакты</a>
</nav>
<span class="dpo-header-actions">
<ViModeButton />
<button aria-controls="mobileMenuPanel" aria-expanded="false" aria-label="Меню" class="dpo-burger" id="mobileMenuBtn" type="button">
<span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
</button>
<a class="dpo-nav-cta" data-application="" href="#contacts">Подать заявку</a>
</span>
</div>
  <div class="dpo-menu-panel dpo-mobile-panel" id="mobileMenuPanel" role="group" aria-label="Меню">
    <nav aria-label="Меню" class="dpo-mobile-nav">
<a href="/catalog">{CATALOG_LINK_LABEL}</a>
<a href="#formats">Форматы</a>
<a href="#teachers">Преподаватели</a>
<a href="/ratings">Рейтинги</a>
<a href="#contacts">Контакты</a>
<a class="dpo-mobile-apply" data-application="" href="#contacts">Подать заявку</a>
</nav>
  </div>
</header>
