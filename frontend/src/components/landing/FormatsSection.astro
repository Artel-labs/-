---
import type { Format } from "../../lib/landing";
import FormatCard from "./FormatCard.astro";

interface Props {
  formats: Format[];
}

const { formats } = Astro.props;
---

<section data-screen-label="Formats" id="formats" class="formats-section">
  <div class="dpo-container">
    <h2 class="formats-title">Выберите свою траекторию развития</h2>
    <p class="formats-lead">Право&nbsp;— это динамичная сфера, требующая постоянного обновления знаний. Мы&nbsp;открываем доступ к&nbsp;качественному юридическому образованию для действующих профессионалов и&nbsp;всех, кто стремится развивать свои компетенции в&nbsp;юриспруденции.</p>
    <p class="formats-lead">В&nbsp;наших программах сочетаются фундаментальная теория с&nbsp;актуальной практикой.</p>
    <ul class="dpo-formats">
      {formats.map((format) => <FormatCard format={format} />)}
    </ul>
  </div>
</section>
