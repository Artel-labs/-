---
interface Props {
  review: { text: string; author: string; path?: string; program?: string };
  duplicate?: boolean;
}

const { review, duplicate = false } = Astro.props;
---

<figure class="dpo-review">
  <svg
    class="dpo-review-quote"
    aria-hidden="true"
    viewBox="0 0 40 32"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"><path d="M17 5 L6 16 L17 27 M33 5 L22 16 L33 27"></path></svg
  >
  <blockquote class="dpo-review-text">{review.text}</blockquote>
  <figcaption class="dpo-review-foot">
    <p class="dpo-review-author">{review.author}</p>
    {
      review.path && review.program && (
        <a class="dpo-review-program" href={review.path} tabindex={duplicate ? "-1" : undefined}>
          {review.program}
        </a>
      )
    }
  </figcaption>
</figure>
