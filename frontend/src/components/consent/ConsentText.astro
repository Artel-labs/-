---
import type { Consent } from "../../lib/consent";

interface Props {
  consent: Consent;
}

const { consent } = Astro.props;
---

<h1>{consent.title}</h1>
{
  consent.paragraphs.map((paragraph) => {
    const [before, after] = consent.withdraw_text ? paragraph.split(consent.withdraw_text, 2) : [paragraph];
    return after === undefined ? (
      <p>{paragraph}</p>
    ) : (
      <p>
        {before}
        <a href={consent.withdraw_url} target="_blank" rel="noopener">
          {consent.withdraw_text}
        </a>
        {after}
      </p>
    );
  })
}
<p class="updated">
  Текст соответствует <a href={consent.source} target="_blank" rel="noopener">{consent.source}</a>
</p>
