---
import type { Starts } from "../../lib/announcements";
import { sitePath } from "../../lib/program";

interface Props {
  starts: Starts | null;
}

const { starts } = Astro.props;
---

{
  starts ? (
    <section class="starts" aria-label="Анонсы программ по месяцам">
      <div class="starts-months" aria-label="Месяцы">
        {starts.months.map((month, index) => (
          <button type="button" class="starts-chip" data-target={month.anchor} aria-pressed={index === 0}>
            {month.label}
          </button>
        ))}
      </div>
      {starts.legend.length > 0 && (
        <ul class="starts-legend" aria-label="Цвет точки — направление программы">
          {starts.legend.map((sphere) => (
            <li>
              <i class="tl-dot" data-sphere={sphere.slug} aria-hidden="true" />
              {sphere.title}
            </li>
          ))}
        </ul>
      )}
      <div class="an">
        {starts.months.map((month) => (
          <section class="an-month" id={month.anchor} aria-labelledby={`${month.anchor}-title`}>
            <h2 class="an-month-label" id={`${month.anchor}-title`}>
              {month.caption}
            </h2>
            <ol class="an-items">
              {month.items.map((item) => (
                <li>
                  <a class="tl-card" href={sitePath(item.path)} title={item.hint}>
                    <span class="tl-when">{item.when}</span>
                    <span class="tl-name">{item.title}</span>
                    <span class="tl-meta">
                      {item.sphere && <i class="tl-dot" data-sphere={item.sphere} aria-hidden="true" />}
                      {item.meta}
                    </span>
                    <span class="tl-price">{item.price}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </section>
  ) : (
    <p class="an-empty">
      Ближайших стартов пока нет. Все программы&nbsp;— в&nbsp;<a href="/catalog">портфеле программ</a>.
    </p>
  )
}

<script>
  import { setupStartsBoard } from "../../scripts/starts-board";

  setupStartsBoard();
</script>
