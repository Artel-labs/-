---
import type { CatalogPage } from "../../lib/catalog";
import { CATALOG_TITLE } from "../../lib/catalog-meta";

interface Props {
  catalog: CatalogPage;
}

const SITE_NAME = "Центр ДПО · Факультет права НИУ ВШЭ";
const KEYWORDS =
  "ДПО, повышение квалификации юристов, профессиональная переподготовка, право, НИУ ВШЭ, факультет права, курсы для юристов";
const SHARE_DESCRIPTION =
  "26 курсов повышения квалификации и профессиональной переподготовки — с ценой, форматом и датой старта.";
const SHARE_IMAGE_WIDTH = "2226";
const SHARE_IMAGE_HEIGHT = "1298";
const SHARE_IMAGE_ALT = "Статуя Фемиды с весами на фоне здания факультета права НИУ ВШЭ";
const TWITTER_TITLE = "Каталог программ ДПО · Факультет права НИУ ВШЭ";
const TWITTER_DESCRIPTION = "Программы повышения квалификации и переподготовки НИУ ВШЭ.";

const { catalog } = Astro.props;
---

<meta name="robots" content="index, follow" />
<meta name="keywords" content={KEYWORDS} />
<link rel="canonical" href={catalog.canonical_url} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="ru_RU" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={CATALOG_TITLE} />
<meta property="og:description" content={SHARE_DESCRIPTION} />
<meta property="og:url" content={catalog.canonical_url} />
<meta property="og:image" content={catalog.image_url} />
<meta property="og:image:width" content={SHARE_IMAGE_WIDTH} />
<meta property="og:image:height" content={SHARE_IMAGE_HEIGHT} />
<meta property="og:image:alt" content={SHARE_IMAGE_ALT} />
<meta name="twitter:image" content={catalog.image_url} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={TWITTER_TITLE} />
<meta name="twitter:description" content={TWITTER_DESCRIPTION} />
<script is:inline type="application/ld+json" set:html={catalog.structured_data} />
