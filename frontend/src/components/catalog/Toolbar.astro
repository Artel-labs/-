---
import Icon from "../Icon.astro";

interface Props {
  totalLabel: string;
}

const { totalLabel } = Astro.props;
---

<div class="toolbar">
  <div class="search-wrap">
    <input
      type="search"
      id="searchInput"
      placeholder="Поиск по&nbsp;названию, типу, формату…"
      autocomplete="off"
      enterkeyhint="search"
      aria-label="Поиск программ"
    />
    <span class="search-icon" aria-hidden="true"><Icon name="search" /></span>
  </div>
  <label class="sort-wrap" for="sortSelect">
    <span class="sort-label">Сортировка</span>
    <select id="sortSelect" class="sort-select">
      <option value="default">по&nbsp;каталогу</option>
      <option value="start">по&nbsp;дате старта</option>
      <option value="price-asc">по&nbsp;цене: сначала дешевле</option>
      <option value="price-desc">по&nbsp;цене: сначала дороже</option>
      <option value="title">по&nbsp;названию</option>
    </select>
  </label>
  <button type="button" class="reset" id="resetFilters" disabled>Сбросить фильтры</button>
  <span class="result-count" id="resultCount" aria-live="polite" data-total-label={totalLabel}>{totalLabel}</span>
</div>
