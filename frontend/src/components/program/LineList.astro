---
import Block from "./Block.astro";

interface Props {
  title: string;
  items: string[];
  listClass: string;
  ordered?: boolean;
  sub?: string | undefined;
}

const { title, items, listClass, ordered = false, sub } = Astro.props;
const List = ordered ? "ol" : "ul";
---

{
  items.length > 0 && (
    <Block title={title} sub={sub}>
      <List class={listClass}>
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </List>
    </Block>
  )
}
