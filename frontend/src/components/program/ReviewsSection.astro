---
import type { Review } from "../../lib/program";
import ReviewFigure from "../ReviewFigure.astro";
import Block from "./Block.astro";
import { HSE_SOURCE_NOTE } from "./notes";

interface Props {
  reviews: Review[];
}

const { reviews } = Astro.props;
---

{
  reviews.length > 0 && (
    <Block title="Отзывы выпускников" sub={HSE_SOURCE_NOTE}>
      <div class="dpo-reviews-track" role="region" aria-label="Отзывы выпускников" tabindex="0">
        {reviews.map((review) => (
          <ReviewFigure review={review} />
        ))}
      </div>
    </Block>
  )
}
