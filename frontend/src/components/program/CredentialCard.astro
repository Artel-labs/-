---
import type { Credential } from "../../lib/program";

interface Props {
  credential: Credential | null;
}

const { credential } = Astro.props;
---

{
  credential && (
    <div class="card doc">
      <svg
        class="doc-vignette"
        aria-hidden="true"
        viewBox="0 0 160 160"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M46 34 a10 10 0 1 0 0 20 H118 a10 10 0 0 0 10 -10 a10 10 0 0 0 -10 -10 Z" />
        <path d="M56 54 V118 a8 8 0 0 0 8 8 H98" />
        <path d="M128 44 V70" />
        <path d="M68 72 H104 M68 86 H112 M68 100 H96" />
        <circle cx="118" cy="112" r="11" />
        <path d="M113 121 L108 140 M123 121 L128 140" />
      </svg>
      <span class="doc-tag">{credential.tag}</span>
      <h2>{credential.name}</h2>
      <p>{credential.note}</p>
      <p class="doc-note">Документ выдаёт НИУ ВШЭ.</p>
    </div>
  )
}
