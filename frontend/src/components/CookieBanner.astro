---
import "../styles/consent.css";
---

<div id="cookieBanner" role="region" aria-label="Согласие на&nbsp;использование cookies" hidden>
  <p>
    Мы&nbsp;используем cookies и&nbsp;локальную аналитику посещений (страницы, время, интерес к&nbsp;программам) для улучшения сайта.
    Яндекс.Метрика&nbsp;— только при настроенном счётчике. Вы&nbsp;можете принять или отказаться. Подробнее&nbsp;— в <a href="/privacy"
      >Политике обработки персональных данных</a
    >.
  </p>
  <div class="cb-actions">
    <button type="button" class="cb-accept">Принять</button>
    <button type="button" class="cb-decline">Отклонить</button>
  </div>
</div>

<script>
  import { setupAnalytics } from "../scripts/analytics";
  import { setupCookieBanner } from "../scripts/consent";

  setupAnalytics();
  setupCookieBanner();
</script>
