---
interface Props {
  privacyLink?: boolean;
}

const { privacyLink = false } = Astro.props;
---

<footer>
  <span>Центр ДПО факультета права НИУ ВШЭ</span>
  <span class:list={{ "footer-links": privacyLink }}>
    {privacyLink && <a href="/privacy">Политика обработки персональных данных</a>}
    <a href="https://www.hse.ru/sveden/" rel="noopener">Сведения об образовательной организации</a>
  </span>
</footer>
