---
import "../styles/catalog.css";
import "../styles/announcements.css";
import ApplicationForm from "../components/ApplicationForm.astro";
import CookieBanner from "../components/CookieBanner.astro";
import CrowLauncher from "../components/CrowLauncher.astro";
import MainHeader from "../components/MainHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SkipLink from "../components/SkipLink.astro";
import SupportBot from "../components/SupportBot.astro";
import AnnouncementsBoard from "../components/announcements/AnnouncementsBoard.astro";
import AnnouncementsHead from "../components/announcements/AnnouncementsHead.astro";
import AnnouncementsHero from "../components/announcements/AnnouncementsHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchAnnouncementsPage } from "../lib/announcements";
import { ANNOUNCEMENTS_PATH } from "../lib/nav";

const TITLE = "Анонсы программ ДПО · Факультет права НИУ ВШЭ";
const DESCRIPTION =
  "Ближайшие старты программ повышения квалификации и профессиональной переподготовки факультета права НИУ ВШЭ — по датам, с форматом и ценой.";

const page = await fetchAnnouncementsPage();
if (!page) {
  return new Response(null, { status: 404 });
}
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <AnnouncementsHead slot="head" page={page} title={TITLE} description={DESCRIPTION} />
  <SkipLink />
  <MainHeader current={ANNOUNCEMENTS_PATH} />
  <AnnouncementsHero />
  <main id="main">
    <AnnouncementsBoard starts={page.starts} />
  </main>
  <SiteFooter copyright />
  <ApplicationForm />
  <CookieBanner />
  <CrowLauncher />
  <SupportBot />
</BaseLayout>
